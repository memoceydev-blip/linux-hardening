## /etc/fstab
/dev/mapper/ubuntu--vg-root       /               ext4    defaults                      0  1
/dev/mapper/ubuntu--vg-tmp        /tmp            ext4    defaults,nodev,nosuid,noexec  0  2
/dev/mapper/ubuntu--vg-var        /var            ext4    defaults,nodev                0  2
/dev/mapper/ubuntu--vg-vartmp     /var/tmp        ext4    defaults,nodev,nosuid,noexec  0  2
/dev/mapper/ubuntu--vg-varlog     /var/log        ext4    defaults,nodev,nosuid,noexec  0  2
/dev/mapper/ubuntu--vg-audit      /var/log/audit  ext4    defaults,nodev,nosuid,noexec  0  2
/dev/mapper/ubuntu--vg-home       /home           ext4    defaults,nodev,nosuid         0  2
tmpfs                             /dev/shm        tmpfs   defaults,nodev,nosuid,noexec  0  0
